{
	"name": "jentic-one-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"codegen": "openapi --input openapi.json --output src/shared/api/generated --client fetch --useOptions",
		"gen:favicons": "node scripts/gen-favicons.mjs",
		"test": "vitest",
		"test:run": "vitest run",
		"test:lint": "vitest run --config vitest.lint.config.ts",
		"test:coverage": "vitest run --coverage",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:docker": "playwright test --config=playwright.docker.config.ts"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.101.4",
		"clsx": "^2.1.1",
		"framer-motion": "^13.1.1",
		"lucide-react": "^1.32.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-router": "^8.3.0",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/browser": "^4.1.11",
		"@vitest/browser-playwright": "^4.1.9",
		"@vitest/coverage-istanbul": "^4.1.5",
		"axe-core": "^4.13.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.11.0",
		"msw": "^2.15.0",
		"openapi-typescript-codegen": "^0.31.0",
		"pg": "^8.23.0",
		"png-to-ico": "^3.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.3",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.4"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
