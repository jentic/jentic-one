# Production configuration example.
# Copy this file and fill in real values, or supply secrets via environment
# variables (JENTIC__DATABASES__REGISTRY__PASSWORD=...).
#
# Production supports both single-database (schema isolation) and
# multi-database deployments. The default local/CI setup uses a single
# database with separate schemas.

databases:
  registry:
    host: db.internal
    port: 5432
    name: jentic
    user: app_registry
    password: CHANGE_ME
    pool_max: 20
    schema_name: registry
  control:
    host: db.internal
    port: 5432
    name: jentic
    user: app_control
    password: CHANGE_ME
    pool_max: 15
    schema_name: control
  admin:
    host: db.internal
    port: 5432
    name: jentic
    user: app_admin
    password: CHANGE_ME
    pool_max: 10
    schema_name: admin

services:
  request_timeout_s: 30.0
  retry_max: 3
  retry_backoff_s: 1.0

runtime:
  debug: false
  log_level: INFO
  maintenance_mode: false

server:
  host: 0.0.0.0
  port: 8000
  reload: false
  # Locality label reported by the public GET /instance identity probe:
  # "local" (default) for a self-hosted install on your own machine/network,
  # "remote" for a hosted install run elsewhere.
  # backend: local
  # Daemon-native MCP over Streamable HTTP (/mcp) and its interactive-OAuth
  # surface. Both are off by default. OAuth-client self-registrations (DCR)
  # land in the admin approval queue by default — auto_approve_clients is an
  # explicit opt-in for deployments that accept self-registered clients
  # without review.
  # mcp:
  #   enabled: true
  #   oauth:
  #     enabled: true
  #     auto_approve_clients: false   # default; set true to skip the queue

apps:
  - registry
  - admin
  - control
  - auth

# Public base URL of the app, so issued OAuth/OIDC token iss/aud and connect
# redirect URIs are correct.
auth:
  canonical_base_url: "https://jentic.example.com"
  platform_clients:
    - client_id: "jentic-one-spa"
      redirect_uris:
        - "https://jentic.example.com/app/auth/callback"

# Credential-at-rest encryption keyset (AES-256-GCM). Required for credential
# WRITES. Keep the key material out of this file in production: point each
# entry at a secret file (docker/k8s secret mount, systemd LoadCredential —
# readable only by the server user, 0600) with `material_file`, or name an
# environment variable holding it with `material_env`. Inline `material` also
# works (vault-templated files) — then treat the whole file as a secret.
# Exactly one source per entry. Generate material:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
credentials:
  encryption:
    active_id: v1
    entries:
      - id: v1
        material_file: /run/secrets/jentic-encryption-key
        # or:  material_env: JENTIC_ENCRYPTION_KEY_V1
        # or:  material: CHANGE_ME   # pragma: allowlist secret

# Shared-state backend for cross-process coordination. The default (memory)
# keeps rate limiters, consent handles, and circuit state per-process — fine
# for a single-worker install, but a multi-worker or multi-instance deployment
# needs Redis so the token-endpoint limiter and consent-nonce anti-replay
# survive across workers.
broker:
  resilience:
    backend:
      backend: memory
      # backend: redis
      # redis_url: rediss://user:pass@redis.example.com:6379/0
      # redis_key_prefix: jentic:prod:

admin:
  auth:
    # Secret for signing web-session JWTs. REQUIRED in production — supply via
    # JENTIC__ADMIN__AUTH__JWT_SECRET rather than committing it here.
    # jwt_secret: CHANGE_ME
    # Lifetime of a single login JWT. The web UI silently re-mints the token
    # via POST /auth/refresh before it expires (sliding session).
    jwt_ttl_seconds: 3600
    # Absolute cap on a web session: refresh is refused once the original
    # login is older than this window, forcing a fresh sign-in.
    session_ttl_seconds: 43200
