# Production configuration example.
# Copy this file and fill in real values, or supply secrets via environment
# variables (JENTIC__DATABASES__REGISTRY__PASSWORD=...).
#
# Production supports both single-database (schema isolation) and
# multi-database deployments. The default local/CI setup uses a single
# database with separate schemas.

databases:
  registry:
    host: db.internal
    port: 5432
    name: jentic
    user: app_registry
    password: CHANGE_ME
    pool_max: 20
    schema_name: registry
  control:
    host: db.internal
    port: 5432
    name: jentic
    user: app_control
    password: CHANGE_ME
    pool_max: 15
    schema_name: control
  admin:
    host: db.internal
    port: 5432
    name: jentic
    user: app_admin
    password: CHANGE_ME
    pool_max: 10
    schema_name: admin

services:
  request_timeout_s: 30.0
  retry_max: 3
  retry_backoff_s: 1.0

runtime:
  debug: false
  log_level: INFO
  maintenance_mode: false

server:
  host: 0.0.0.0
  port: 8000
  reload: false
  # THE public origin of this deployment (scheme + host [+ port] as clients
  # reach it, e.g. behind your load balancer / ingress). This one knob drives
  # every externally-visible URL: OAuth connect redirect_uri, OIDC issuer &
  # JWT-Bearer audience, DCR registration_client_uri, access-request approval
  # links, async-job _links.self, and the 424 provisioning_url. Set this
  # instead of pinning each of those separately.
  public_base_url: "https://jentic.example.com"
  # Locality label reported by the public GET /instance identity probe:
  # "local" (default) for a self-hosted install on your own machine/network,
  # "remote" for a hosted install run elsewhere.
  # backend: local

apps:
  - registry
  - admin
  - control
  - auth

# Advanced per-field overrides (rarely needed). Each defaults to
# server.public_base_url above and only needs setting when a reverse proxy
# fronts a specific surface on a *different* public origin. When set, the
# specific knob wins over public_base_url:
#   auth.canonical_base_url                       # OIDC issuer / JWT audience / DCR
#   control.access_requests.canonical_base_url    # approval deep links
#   broker.jobs_api_base_url                       # async-job self links
#   broker.account_linking_base_url                # 424 provisioning_url
#   credentials.providers.<id>.redirect_uri        # OAuth callback override

# Credential-at-rest encryption keyset (AES-256-GCM). Required for credential
# WRITES. The keyset is a LIST, so it can't come from a single JENTIC__… env
# var — fill it here and treat the whole file as a secret. Generate material:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
credentials:
  encryption:
    active_id: v1
    entries:
      - id: v1
        material: CHANGE_ME   # pragma: allowlist secret

admin:
  auth:
    # Secret for signing web-session JWTs. REQUIRED in production — supply via
    # JENTIC__ADMIN__AUTH__JWT_SECRET rather than committing it here.
    # jwt_secret: CHANGE_ME
    # Lifetime of a single login JWT. The web UI silently re-mints the token
    # via POST /auth/refresh before it expires (sliding session).
    jwt_ttl_seconds: 3600
    # Absolute cap on a web session: refresh is refused once the original
    # login is older than this window, forcing a fresh sign-in.
    session_ttl_seconds: 43200
