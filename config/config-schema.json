        "canonical_base_url": {
          "default": "",
          "title": "Canonical Base Url",
          "type": "string"
        },
        "ttl_days": {
          "default": 7,
          "title": "Ttl Days",
          "type": "integer"
        }
      },
      "title": "AccessRequestsConfig",
      "type": "object"
    },
    "AdminAuthConfig": {
      "description": "Admin authentication settings.",
      "properties": {
        "failed_login_lockout_seconds": {
          "default": 900,
          "title": "Failed Login Lockout Seconds",
          "type": "integer"
