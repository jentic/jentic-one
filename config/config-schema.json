        },
        "jwt_ttl_seconds": {
          "default": 3600,
          "exclusiveMinimum": 0,
          "title": "Jwt Ttl Seconds",
          "type": "integer"
        },
        "session_ttl_seconds": {
          "default": 43200,
          "exclusiveMinimum": 0,
          "title": "Session Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "AdminAuthConfig",
      "type": "object"
    },
    "AdminConfig": {
      "description": "Admin surface configuration.",
      "properties": {
        "auth": {
          "$ref": "#/$defs/AdminAuthConfig"
        },
        "invite": {
          "$ref": "#/$defs/AdminInviteConfig"
        }
      },
      "title": "AdminConfig",
      "type": "object"
    },
    "AdminInviteConfig": {
      "description": "Admin invite token settings.",
      "properties": {
        "pepper": {
          "default": "**********",
          "format": "password",
          "title": "Pepper",
          "type": "string",
          "writeOnly": true
        },
        "ttl_days": {
          "default": 7,
          "title": "Ttl Days",
          "type": "integer"
        }
      },
      "title": "AdminInviteConfig",
      "type": "object"
    },
    "AuthConfig": {
      "description": "Platform-actors OAuth surface configuration.",
      "properties": {
        "access_ttl_seconds": {
          "default": 3600,
          "title": "Access Ttl Seconds",
          "type": "integer"
        },
        "assertion_max_ttl_seconds": {
          "default": 300,
          "title": "Assertion Max Ttl Seconds",
          "type": "integer"
        },
        "auth_code_ttl_seconds": {
          "default": 300,
          "title": "Auth Code Ttl Seconds",
          "type": "integer"
        },
        "canonical_base_url": {
          "default": "",
          "title": "Canonical Base Url",
          "type": "string"
        },
        "id_signing": {
          "items": {
            "$ref": "#/$defs/SigningKeyConfig"
          },
          "title": "Id Signing",
          "type": "array"
        },
        "idp": {
          "$ref": "#/$defs/IdpConfig"
        },
        "rat_ttl_seconds": {
          "default": 900,
          "title": "Rat Ttl Seconds",
          "type": "integer"
        },
        "refresh_ttl_seconds": {
          "default": 604800,
          "title": "Refresh Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BackendKind": {
      "description": "Which shared-state implementation to build.\n\nDefined here as the single source of truth; later PRs (resilience §05)\nimport it from this package rather than defining a second enum.",
      "enum": [
        "memory",
        "redis"
      ],
      "title": "BackendKind",
      "type": "string"
    },
    "BaseModel": {
      "properties": {},
      "title": "BaseModel",
      "type": "object"
    },
    "BrokerConfig": {
      "description": "Broker surface configuration.",
      "properties": {
        "account_linking_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Linking Base Url"
        },
        "egress": {
          "$ref": "#/$defs/EgressConfig"
        },
        "idempotency": {
          "$ref": "#/$defs/IdempotencyConfig"
        },
        "jobs_api_base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jobs Api Base Url"
        },
        "jwt_secret": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jwt Secret"
        },
        "jwt_verification": {
          "$ref": "#/$defs/JwtVerificationConfig"
        },
        "resilience": {
          "$ref": "#/$defs/BrokerResilienceConfig"
        },
        "resolve_cache_ttl_seconds": {
          "default": 3.0,
          "title": "Resolve Cache Ttl Seconds",
          "type": "number"
        },
        "rule_cache_ttl_s": {
          "default": 3.0,
          "title": "Rule Cache Ttl S",
          "type": "number"
        },
        "toolkit_cache_ttl_s": {
          "default": 3.0,
          "title": "Toolkit Cache Ttl S",
          "type": "number"
        },
        "upstream_timeout_s": {
          "default": 30.0,
          "title": "Upstream Timeout S",
          "type": "number"
        }
      },
      "title": "BrokerConfig",
      "type": "object"
    },
    "BrokerResilienceConfig": {
      "description": "Resilience envelope: admission (§04 R1) + rate limit / circuit (§05).\n\nThe shared-state ``backend`` selection drives *both* the rate limiter and\nthe circuit breaker (memory default; Redis is cluster-wide, §06). Queue\nbackpressure / async-credential / retention knobs land in a later §05 slice.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/StateBackendConfig"
        },
        "circuit_breaker": {
          "$ref": "#/$defs/CircuitBreakerConfig"
        },
        "max_in_flight": {
          "default": 200,
          "title": "Max In Flight",
          "type": "integer"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimitConfig"
        },
        "readiness_saturation_threshold": {
          "default": 0.9,
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Readiness Saturation Threshold",
          "type": "number"
        },
        "request_deadline_s": {
          "default": 30.0,
          "title": "Request Deadline S",
          "type": "number"
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig"
        },
        "shed_retry_after_s": {
          "default": 5,
          "title": "Shed Retry After S",
          "type": "integer"
        },
        "upstream": {
          "$ref": "#/$defs/UpstreamClientConfig"
        }
      },
      "title": "BrokerResilienceConfig",
      "type": "object"
    },
    "CatalogConfig": {
      "description": "Public API catalog settings (manifest source + staleness).",
      "properties": {
        "manifest_max_age_seconds": {
          "default": 86400,
          "title": "Manifest Max Age Seconds",
          "type": "integer"
        },
        "manifest_url": {
          "default": "https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/apis.json",
          "title": "Manifest Url",
          "type": "string"
        },
        "update_check_interval_seconds": {
          "default": 86400,
          "title": "Update Check Interval Seconds",
          "type": "integer"
        },
        "update_sweep_deadline_seconds": {
          "default": 300,
          "title": "Update Sweep Deadline Seconds",
          "type": "integer"
        },
        "update_sweep_jitter_ratio": {
          "default": 0.15,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Update Sweep Jitter Ratio",
          "type": "number"
        },
        "update_sweep_max_concurrency": {
          "default": 4,
          "title": "Update Sweep Max Concurrency",
          "type": "integer"
        }
      },
      "title": "CatalogConfig",
      "type": "object"
    },
    "CircuitBreakerConfig": {
      "description": "Per-upstream circuit breaker (§05 R5.1).\n\nCounts failures/totals per rolling ``window_s`` on the shared-state\nbackend's atomic counters; when the failure ratio crosses\n``failure_ratio`` the circuit opens (a ``set_if_absent`` latch) and\nfast-fails for ``cooldown_s``. ``observation`` mode tracks + emits\n``would_block`` but still calls the upstream (safe-rollout dry run).",
      "properties": {
        "cooldown_s": {
          "default": 15,
          "title": "Cooldown S",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "enforcement_mode": {
          "default": "blocking",
          "enum": [
            "blocking",
            "observation"
          ],
          "title": "Enforcement Mode",
          "type": "string"
        },
        "failure_ratio": {
          "default": 0.5,
          "title": "Failure Ratio",
          "type": "number"
        },
        "min_calls": {
          "default": 10,
          "title": "Min Calls",
          "type": "integer"
        },
        "window_s": {
          "default": 30,
          "title": "Window S",
          "type": "integer"
        }
      },
      "title": "CircuitBreakerConfig",
      "type": "object"
    },
    "ConnectConfig": {
      "description": "Configuration for the OAuth connect flow.",
      "properties": {
        "state_secret": {
          "default": "**********",
          "format": "password",
          "title": "State Secret",
          "type": "string",
          "writeOnly": true
        },
        "state_ttl_seconds": {
          "default": 600,
          "title": "State Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "ConnectConfig",
      "type": "object"
    },
    "ControlSurfaceConfig": {
      "description": "Control surface configuration.",
      "properties": {
        "access_requests": {
          "$ref": "#/$defs/AccessRequestsConfig"
        }
      },
      "title": "ControlSurfaceConfig",
      "type": "object"
    },
    "CredentialsConfig": {
      "description": "Credentials subsystem configuration.",
      "properties": {
        "connect": {
          "$ref": "#/$defs/ConnectConfig"
        },
        "encryption": {
          "$ref": "#/$defs/EncryptionConfig"
        },
        "providers": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "direct_oauth2": "#/$defs/DirectOAuth2ProviderConfig",
                "pipedream": "#/$defs/PipedreamProviderConfig"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DirectOAuth2ProviderConfig"
              },
              {
                "$ref": "#/$defs/PipedreamProviderConfig"
              }
            ]
          },
          "title": "Providers",
          "type": "object"
        }
      },
      "title": "CredentialsConfig",
      "type": "object"
    },
    "DatabaseConfig": {
      "description": "Connection parameters for a single database.\n\nSupports two backends:\n\n- ``postgres`` (default): uses host/port/user/password/name + schema_name.\n- ``sqlite``: uses ``path`` (a single-file database). The Postgres\n  connection fields are ignored.",
      "properties": {
        "backend": {
          "default": "postgres",
          "enum": [
            "postgres",
            "sqlite"
          ],
          "title": "Backend",
          "type": "string"
        },
        "busy_timeout_ms": {
          "default": 5000,
          "title": "Busy Timeout Ms",
          "type": "integer"
        },
        "host": {
          "default": "localhost",
          "title": "Host",
          "type": "string"
        },
        "journal_mode": {
          "default": "WAL",
          "title": "Journal Mode",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "password": {
          "default": "",
          "format": "password",
          "title": "Password",
          "type": "string",
          "writeOnly": true
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "pool_max": {
          "default": 10,
          "title": "Pool Max",
          "type": "integer"
        },
        "port": {
          "default": 5432,
          "title": "Port",
          "type": "integer"
        },
        "schema_name": {
          "default": "public",
          "title": "Schema Name",
          "type": "string"
        },
        "user": {
          "default": "postgres",
          "title": "User",
          "type": "string"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "DatabasesConfig": {
      "description": "Named database connections.",
      "properties": {
        "admin": {
          "$ref": "#/$defs/DatabaseConfig"
        },
        "control": {
          "$ref": "#/$defs/DatabaseConfig"
        },
        "registry": {
          "$ref": "#/$defs/DatabaseConfig"
        }
      },
      "required": [
        "registry",
        "admin",
        "control"
      ],
      "title": "DatabasesConfig",
      "type": "object"
    },
    "DirectOAuth2ProviderConfig": {
      "description": "Configuration for a direct OAuth2 provider (full settings land in M5).",
      "properties": {
        "authorize_extra_params": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Authorize Extra Params",
          "type": "object"
        },
        "default_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Default Scopes",
          "type": "array"
        },
        "expiry_skew_seconds": {
          "default": 60,
          "title": "Expiry Skew Seconds",
          "type": "integer"
        },
        "kind": {
          "const": "direct_oauth2",
          "default": "direct_oauth2",
          "title": "Kind",
          "type": "string"
        },
        "redirect_uri": {
          "title": "Redirect Uri",
          "type": "string"
        }
      },
      "required": [
        "redirect_uri"
      ],
      "title": "DirectOAuth2ProviderConfig",
      "type": "object"
    },
    "EgressConfig": {
      "description": "Outbound SSRF/egress policy for upstream calls (§08 E2).\n\nDefaults are **strict** (both lists empty) — identical to the historical\nhard-coded behaviour: every private range and the cloud-metadata host are\nblocked. The two allowlists exist because the broker is frequently installed\n*inside* a corporate network to bridge to internal/legacy APIs, where the\ndefault block is a false positive. Both are opt-in, auditable operator\ndecisions; the cloud-metadata IP is a **hard, non-overridable** deny so a\ncredential-stealing SSRF can never be allowlisted by accident.",
      "properties": {
        "allowed_internal_domains": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Internal Domains",
          "type": "array"
        },
        "allowed_private_subnets": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Private Subnets",
          "type": "array"
        },
        "dns_pinning_enabled": {
          "default": true,
          "title": "Dns Pinning Enabled",
          "type": "boolean"
        }
      },
      "title": "EgressConfig",
      "type": "object"
    },
    "EncryptionConfig": {
      "description": "Envelope-encryption keyset configuration.",
      "properties": {
        "active_id": {
          "default": "v1",
          "title": "Active Id",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/EncryptionKey"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "title": "EncryptionConfig",
      "type": "object"
    },
    "EncryptionKey": {
      "description": "A single named encryption key.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "material": {
          "format": "password",
          "title": "Material",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "id",
        "material"
      ],
      "title": "EncryptionKey",
      "type": "object"
    },
    "IdempotencyConfig": {
      "description": "``Idempotency-Key`` replay store (§07, PR-E/1 slim).\n\nSync ``FULL``-mode replay over the shared-state ``AtomicStore`` (memory\ndefault; Redis ⇒ cross-instance). Two TTLs: a *short* ``pending_ttl_s`` claim\n(sized to the request deadline + buffer, so a crash mid-flight frees the key\nin seconds rather than the full replay window) promoted to the *long*\n``ttl_s`` only once the response is stored. Responses over\n``max_response_bytes`` are recorded without their body (replay still prevents\na duplicate side-effect; only byte-for-byte body replay is dropped).\n\nCompliance modes (``metadata_only`` / kill-switch), ``require_for_mutations``,\nasync same-``job_id`` replay, and at-rest encryption are later §07 slices.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_response_bytes": {
          "default": 262144,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "pending_ttl_s": {
          "default": 35.0,
          "title": "Pending Ttl S",
          "type": "number"
        },
        "ttl_s": {
          "default": 86400.0,
          "title": "Ttl S",
          "type": "number"
        }
      },
      "title": "IdempotencyConfig",
      "type": "object"
    },
    "IdpConfig": {
      "description": "External OIDC identity provider configuration.",
      "properties": {
        "authorization_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Endpoint"
        },
        "client_id": {
          "default": "",
          "title": "Client Id",
          "type": "string"
        },
        "client_secret": {
          "default": "",
          "format": "password",
          "title": "Client Secret",
          "type": "string",
          "writeOnly": true
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "exchange_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exchange Endpoint"
        },
        "hosted_domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hosted Domain"
        },
        "issuer": {
          "default": "",
          "title": "Issuer",
          "type": "string"
        },
        "provider": {
          "default": "oidc",
          "title": "Provider",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "userinfo_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Userinfo Endpoint"
        }
      },
      "title": "IdpConfig",
      "type": "object"
    },
    "IngestConfig": {
      "description": "Spec ingestion settings (fetch limits, timeouts, egress policy).",
      "properties": {
        "egress": {
          "$ref": "#/$defs/EgressConfig"
        },
        "fetch_timeout_s": {
          "default": 30.0,
          "title": "Fetch Timeout S",
          "type": "number"
        },
        "max_redirects": {
          "default": 5,
          "title": "Max Redirects",
          "type": "integer"
        },
        "max_spec_bytes": {
          "default": 26214400,
          "title": "Max Spec Bytes",
          "type": "integer"
        }
      },
      "title": "IngestConfig",
      "type": "object"
    },
    "JwtVerificationConfig": {
      "description": "Hardened inbound-JWT verification for the broker edge (§08 E1).\n\nWhen ``trusted_issuers`` is non-empty the broker verifies self-contained JWTs\nagainst the issuers' published JWKS (asymmetric, key-rotation-aware) and\nenforces ``iss`` (trusted set), ``aud`` (``audience``), and ``exp``/``nbf``\nwith ``leeway_s`` clock-skew. Empty (the default) leaves the asymmetric path\noff — the legacy HS256 ``broker.jwt_secret`` path (dev/test) still applies.",
      "properties": {
        "audience": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "leeway_s": {
          "default": 60.0,
          "title": "Leeway S",
          "type": "number"
        },
        "trusted_issuers": {
          "items": {
            "$ref": "#/$defs/TrustedIssuerConfig"
          },
          "title": "Trusted Issuers",
          "type": "array"
        }
      },
      "title": "JwtVerificationConfig",
      "type": "object"
    },
    "LoggingConfig": {
      "description": "File logging sink (in addition to stdout).",
      "properties": {
        "file_backup_count": {
          "default": 5,
