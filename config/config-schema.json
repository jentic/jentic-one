    "StateBackendConfig": {
      "description": "Configuration for :func:`build_state_backend`.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/BackendKind",
          "default": "memory"
        },
        "redis_key_prefix": {
          "default": "jentic:broker:",
          "title": "Redis Key Prefix",
          "type": "string"
