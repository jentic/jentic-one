        "file_dir": {
          "default": ".jentic/logs",
          "title": "File Dir",
          "type": "string"
        },
        "file_enabled": {
          "default": false,
          "title": "File Enabled",
          "type": "boolean"
        },
        "file_max_bytes": {
          "default": 10485760,
          "title": "File Max Bytes",
          "type": "integer"
        },
        "file_name": {
          "default": "app.log",
          "title": "File Name",
          "type": "string"
        }
      },
      "title": "LoggingConfig",
      "type": "object"
    },
    "MetricsConfig": {
