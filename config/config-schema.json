    "PipedreamProviderConfig": {
      "description": "Configuration for a Pipedream-hosted OAuth provider (full settings land in M6).",
      "properties": {
        "client_id": {
          "title": "Client Id",
          "type": "string"
        },
        "client_secret": {
          "format": "password",
          "title": "Client Secret",
          "type": "string",
          "writeOnly": true
        },
        "connect_base_url": {
          "default": "https://api.pipedream.com/v1",
          "title": "Connect Base Url",
          "type": "string"
        },
        "environment": {
          "default": "production",
          "enum": [
            "production",
            "development"
          ],
          "title": "Environment",
          "type": "string"
        },
        "expiry_skew_seconds": {
          "default": 60,
          "title": "Expiry Skew Seconds",
          "type": "integer"
        },
        "kind": {
          "const": "pipedream",
          "default": "pipedream",
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "client_id",
        "client_secret"
      ],
      "title": "PipedreamProviderConfig",
      "type": "object"
    },
    "RateLimitConfig": {
      "description": "Per-caller token-bucket rate limit (§05 R2).\n\nKeyed on the resolved ``actor_id`` and enforced in a post-auth dependency\n(the actor isn't known at admission time, so this can't be a plain\npre-auth middleware). The token bucket itself lives on the shared-state\nbackend (``RateLimitStore``); with the memory backend the limit is\nper-instance, with Redis (§06) it is cluster-wide — no call-site change.",
      "properties": {
        "burst": {
          "default": 100,
          "title": "Burst",
          "type": "integer"
        },
        "default_rpm": {
          "default": 600,
          "title": "Default Rpm",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "RateLimitConfig",
      "type": "object"
    },
    "ReleaseCheckConfig": {
      "description": "\"Update available\" check for the running jentic-one build itself.\n\nPowers ``GET /system/version``: the backend asks GitHub for the newest\npublished release of ``repo`` and compares it against the running build so the\nweb console can surface an \"update available\" banner (and the user menu can\nalways show the current version). This is about *jentic-one's own* release —\ndistinct from ``CatalogConfig``, which tracks the public *API catalog*.\n\nRuns only on a ``local`` backend (a self-hosted install the operator can\nactually update); the hosted platform (``server.backend == \"remote\"``) skips\nit. The result is cached in-process for ``cache_ttl_seconds`` (fetch-on-read,\nno background job), so at most one GitHub request happens per TTL regardless\nof how many clients poll. Every failure degrades to \"latest unknown\" (no\nbanner) rather than erroring — the version probe must never break the app.",
      "properties": {
        "cache_ttl_seconds": {
          "default": 21600,
          "title": "Cache Ttl Seconds",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "repo": {
          "default": "jentic/jentic-one",
          "title": "Repo",
          "type": "string"
        }
      },
      "title": "ReleaseCheckConfig",
      "type": "object"
    },
    "RetryConfig": {
      "description": "Idempotency-aware upstream retry (§09 E4.1).\n\nThe ``RetryRunner`` decorator retries a failed attempt **only** when it is\nsafe to do so: a connect-phase failure (no bytes on the wire) is retryable\nfor any method, while a post-send failure (read timeout, mirrored ``429``/\n``503``) is retried only for idempotent methods or when an\n``Idempotency-Key`` is present — a blind ``POST`` retry is a double-spend.\nEach attempt still flows through the circuit breaker (retry *outside*,\nbreaker *inside*); the whole loop is bounded by the request deadline.",
      "properties": {
        "base_backoff_s": {
          "default": 0.2,
          "title": "Base Backoff S",
          "type": "number"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_attempts": {
          "default": 3,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_backoff_s": {
          "default": 5.0,
          "title": "Max Backoff S",
          "type": "number"
        },
        "retry_statuses": {
          "items": {
            "type": "integer"
          },
          "title": "Retry Statuses",
          "type": "array"
        }
      },
      "title": "RetryConfig",
      "type": "object"
    },
    "RuntimeConfig": {
      "description": "Hot-reloadable runtime flags.",
      "properties": {
        "debug": {
          "default": false,
          "title": "Debug",
          "type": "boolean"
        },
        "log_level": {
          "default": "INFO",
          "title": "Log Level",
          "type": "string"
        },
        "maintenance_mode": {
          "default": false,
          "title": "Maintenance Mode",
          "type": "boolean"
        }
      },
      "title": "RuntimeConfig",
      "type": "object"
    },
    "SearchConfig": {
      "description": "Search configuration.\n\nThe built-in mode is \"lexical\" (BM25 on SQLite, native full-text on\nPostgreSQL). ``search_mode`` is validated against the registered\nSearchStrategy set at resolve time (``resolve_strategy``), so an unknown mode\nfails loudly with the available modes for the active dialect rather than at\nconfig load. Additional modes (e.g. \"semantic\", \"vector\") can be registered\nvia ``register_strategy`` without editing this schema.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "search_enabled": {
          "default": true,
          "title": "Search Enabled",
          "type": "boolean"
        },
        "search_mode": {
          "default": "lexical",
          "title": "Search Mode",
          "type": "string"
        }
      },
      "title": "SearchConfig",
      "type": "object"
    },
    "SecurityConfig": {
      "description": "Platform security event thresholds.",
      "properties": {
        "auth_failure_event_threshold": {
          "default": 10,
          "minimum": 1,
          "title": "Auth Failure Event Threshold",
          "type": "integer"
        },
        "credential_expiring_soon_window_h": {
          "default": 72,
          "minimum": 1,
          "title": "Credential Expiring Soon Window H",
          "type": "integer"
        },
        "credential_expiry_sweep_interval_ticks": {
          "default": 60,
          "minimum": 1,
          "title": "Credential Expiry Sweep Interval Ticks",
          "type": "integer"
        },
        "execution_repeated_failure_critical_threshold": {
          "default": 20,
          "minimum": 1,
          "title": "Execution Repeated Failure Critical Threshold",
          "type": "integer"
        },
        "execution_repeated_failure_threshold": {
          "default": 5,
          "minimum": 1,
          "title": "Execution Repeated Failure Threshold",
          "type": "integer"
        },
        "execution_repeated_failure_window_s": {
          "default": 300,
          "minimum": 1,
          "title": "Execution Repeated Failure Window S",
          "type": "integer"
        }
      },
      "title": "SecurityConfig",
      "type": "object"
    },
    "ServerConfig": {
      "description": "HTTP server settings.",
      "properties": {
        "backend": {
          "default": "local",
          "enum": [
            "local",
            "remote"
          ],
          "title": "Backend",
          "type": "string"
        },
        "host": {
          "default": "0.0.0.0",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8000,
          "title": "Port",
          "type": "integer"
        },
        "reload": {
          "default": false,
          "title": "Reload",
          "type": "boolean"
        }
      },
      "title": "ServerConfig",
      "type": "object"
    },
    "ServicesConfig": {
      "description": "Service-level settings (immutable after boot).",
      "properties": {
        "request_timeout_s": {
          "default": 30.0,
          "title": "Request Timeout S",
          "type": "number"
