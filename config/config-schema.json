    "TelemetryConfig": {
      "description": "Anonymous product-telemetry settings (issue #446).\n\nDefaults to **OFF**: an instance whose config omits this block (non-onboarded\nor hand-rolled) sends nothing. The onboarding CLI writes ``enabled``\nexplicitly (a yes-default ``[Y]/n`` prompt) so the on-by-default UX lives in\nthe prompt, not the code default. ``instance_id`` seeds the durable admin-DB\nidentity row on first startup for opted-in instances.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "endpoint": {
          "default": "https://api.jentic.com/api/v1",
          "title": "Endpoint",
          "type": "string"
        },
        "flush_interval_s": {
          "default": 30.0,
          "title": "Flush Interval S",
          "type": "number"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "max_batch": {
          "default": 100,
          "title": "Max Batch",
          "type": "integer"
        },
        "queue_max": {
          "default": 10000,
          "title": "Queue Max",
          "type": "integer"
        },
        "request_timeout_s": {
          "default": 5.0,
          "title": "Request Timeout S",
          "type": "number"
        }
      },
      "title": "TelemetryConfig",
      "type": "object"
    },
    "TracingConfig": {
      "description": "Tracing exporter configuration.",
      "properties": {
        "exporter": {
          "default": "otlp",
          "enum": [
            "otlp",
            "none"
          ],
          "title": "Exporter",
          "type": "string"
        }
      },
      "title": "TracingConfig",
      "type": "object"
    },
    "TrustedIssuerConfig": {
      "description": "A single trusted token issuer (IdP) and where to fetch its public keys.\n\nThe verifier holds one JWKS client per issuer; an unknown ``kid`` triggers a\nbounded re-fetch (key rotation picked up without a restart). ``algorithms``\nis the per-issuer asymmetric allowlist — HMAC/``none`` are rejected here so an\nissuer can't be downgraded to a symmetric/forgeable signature.",
      "properties": {
        "algorithms": {
          "items": {
            "type": "string"
          },
          "title": "Algorithms",
          "type": "array"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "jwks_url": {
          "title": "Jwks Url",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "jwks_url"
      ],
      "title": "TrustedIssuerConfig",
      "type": "object"
    },
    "UpstreamClientConfig": {
      "description": "Bounds for the single shared outbound ``httpx.AsyncClient`` (§04, PR-B).\n\nThe timeouts are httpx semantics: ``read_timeout_s`` is the *between-bytes*\ngap timeout (per read), **not** a whole-stream cap — a trickle that keeps\nsending under the limit can hold a pool slot open. The overall transfer\ndeadline is owned by the response-streaming guard (§08/E2.4), not here.",
      "properties": {
        "connect_timeout_s": {
          "default": 5.0,
          "title": "Connect Timeout S",
          "type": "number"
        },
        "http2": {
          "default": true,
          "title": "Http2",
          "type": "boolean"
        },
        "max_connections": {
          "default": 200,
          "title": "Max Connections",
          "type": "integer"
        },
        "max_keepalive": {
          "default": 50,
          "title": "Max Keepalive",
          "type": "integer"
        },
        "max_per_host": {
          "default": 50,
          "title": "Max Per Host",
          "type": "integer"
        },
        "max_request_bytes": {
          "default": 10485760,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_request_bytes_by_type": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Max Request Bytes By Type",
          "type": "object"
        },
        "max_response_bytes": {
          "default": 10485760,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "pool_timeout_s": {
          "default": 2.0,
          "title": "Pool Timeout S",
          "type": "number"
        },
        "read_timeout_s": {
          "default": 30.0,
          "title": "Read Timeout S",
          "type": "number"
        },
        "stream_passthrough_enabled": {
          "default": true,
          "title": "Stream Passthrough Enabled",
          "type": "boolean"
        },
        "transfer_deadline_s": {
          "default": 300.0,
          "title": "Transfer Deadline S",
          "type": "number"
        },
        "write_timeout_s": {
          "default": 30.0,
          "title": "Write Timeout S",
          "type": "number"
        }
      },
      "title": "UpstreamClientConfig",
      "type": "object"
    },
    "WorkerConfig": {
      "description": "Background job-worker durability knobs (§09 E4.2).\n\nThe worker claims a job, sets a **visibility deadline** (``visibility_timeout_s``\nfrom claim), and processes it. A job left ``RUNNING`` past that deadline by a\ncrashed worker/pod is reclaimed on a later poll. A handler failure requeues the\njob with capped exponential backoff up to ``max_attempts`` claims; beyond that\nit is dead-lettered (poison-message handling) rather than looped forever.",
      "properties": {
        "drain_timeout_s": {
          "default": 25.0,
          "title": "Drain Timeout S",
          "type": "number"
        },
        "max_attempts": {
          "default": 5,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retry_backoff_base_s": {
          "default": 2.0,
          "title": "Retry Backoff Base S",
          "type": "number"
        },
        "retry_backoff_max_s": {
          "default": 60.0,
          "title": "Retry Backoff Max S",
          "type": "number"
        },
        "visibility_timeout_s": {
          "default": 120.0,
          "title": "Visibility Timeout S",
          "type": "number"
        }
      },
      "title": "WorkerConfig",
      "type": "object"
    }
  },
