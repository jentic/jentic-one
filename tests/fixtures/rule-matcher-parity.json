{
  "_readme": "Parity fixture consumed by both the Python matcher (tests/unit/shared/permissions/test_matching_parity.py) and the TS matcher (ui/src/shared/credentials/lib/__tests__/rule-matcher.test.ts). Each case pins the same input/output pair on both sides; any divergence fails CI. Do NOT edit this file to make a broken side pass — fix the divergence at the source. New cases: add here and update both test files' snapshot expectations.",
  "cases": [
    {
      "name": "empty rules → default deny",
      "rules": [],
      "request": { "method": "GET", "path": "/repos", "operation_id": null },
      "allowed": false
    },
    {
      "name": "allow-all-GET matches",
      "rules": [
        { "effect": "allow", "methods": ["GET"], "path": "/", "match_mode": "prefix" }
      ],
      "request": { "method": "GET", "path": "/repos/x", "operation_id": null },
      "allowed": true
    },
    {
      "name": "allow-GET does not match POST",
      "rules": [
        { "effect": "allow", "methods": ["GET"], "path": "/", "match_mode": "prefix" }
      ],
      "request": { "method": "POST", "path": "/repos", "operation_id": null },
      "allowed": false
    },
    {
      "name": "prefix constrains scope",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos",
          "match_mode": "prefix"
        }
      ],
      "request": { "method": "GET", "path": "/orgs", "operation_id": null },
      "allowed": false
    },
    {
      "name": "exact match — hit",
      "rules": [
        { "effect": "allow", "methods": ["GET"], "path": "/user", "match_mode": "exact" }
      ],
      "request": { "method": "GET", "path": "/user", "operation_id": null },
      "allowed": true
    },
    {
      "name": "exact match — no partial",
      "rules": [
        { "effect": "allow", "methods": ["GET"], "path": "/user", "match_mode": "exact" }
      ],
      "request": { "method": "GET", "path": "/user/emails", "operation_id": null },
      "allowed": false
    },
    {
      "name": "regex full-match (not startswith)",
      "rules": [
        { "effect": "allow", "methods": ["GET"], "path": "/repos", "match_mode": "regex" }
      ],
      "request": { "method": "GET", "path": "/repos/x", "operation_id": null },
      "allowed": false
    },
    {
      "name": "regex with wildcard",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/.*",
          "match_mode": "regex"
        }
      ],
      "request": { "method": "GET", "path": "/repos/x", "operation_id": null },
      "allowed": true
    },
    {
      "name": "invalid regex → fail-closed",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/[",
          "match_mode": "regex"
        }
      ],
      "request": { "method": "GET", "path": "/repos/x", "operation_id": null },
      "allowed": false
    },
    {
      "name": "deny wins over later allow (first-match)",
      "rules": [
        {
          "effect": "deny",
          "methods": ["DELETE"],
          "path": "/",
          "match_mode": "prefix"
        },
        { "effect": "allow", "methods": ["DELETE"], "path": "/", "match_mode": "prefix" }
      ],
      "request": { "method": "DELETE", "path": "/repos/x", "operation_id": null },
      "allowed": false
    },
    {
      "name": "operations-scoped rule",
      "rules": [
        {
          "effect": "allow",
          "methods": null,
          "path": null,
          "match_mode": "regex",
          "operations": ["reposGet"]
        }
      ],
      "request": { "method": "GET", "path": "/repos/x", "operation_id": "reposGet" },
      "allowed": true
    },
    {
      "name": "operations-scoped rule — mismatch",
      "rules": [
        {
          "effect": "allow",
          "methods": null,
          "path": null,
          "match_mode": "regex",
          "operations": ["reposGet"]
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/x",
        "operation_id": "reposDelete"
      },
      "allowed": false
    },
    {
      "name": "condition-less allow is skipped (broker safety)",
      "rules": [
        { "effect": "allow", "methods": null, "path": null, "match_mode": "regex" },
        { "effect": "allow", "methods": ["GET"], "path": "/", "match_mode": "prefix" }
      ],
      "request": { "method": "GET", "path": "/repos", "operation_id": null },
      "allowed": true
    },
    {
      "name": "condition-less deny keeps its catch-all semantics",
      "rules": [
        { "effect": "deny", "methods": null, "path": null, "match_mode": "regex" }
      ],
      "request": { "method": "GET", "path": "/repos", "operation_id": null },
      "allowed": false
    },
    {
      "name": "case-insensitive method match",
      "rules": [
        { "effect": "allow", "methods": ["get"], "path": "/", "match_mode": "prefix" }
      ],
      "request": { "method": "GET", "path": "/repos", "operation_id": null },
      "allowed": true
    },
    {
      "name": "exact rule with {placeholder} matches concrete path",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/{owner}/{repo}",
          "match_mode": "exact"
        }
      ],
      "request": { "method": "GET", "path": "/repos/octocat/hello-world", "operation_id": null },
      "allowed": true
    },
    {
      "name": "exact rule with {placeholder} rejects segment-count mismatch",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/{owner}/{repo}",
          "match_mode": "exact"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/octocat/hello-world/commits",
        "operation_id": null
      },
      "allowed": false
    },
    {
      "name": "exact rule with {placeholder} rejects placeholder spanning slashes",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/{owner}",
          "match_mode": "exact"
        }
      ],
      "request": { "method": "GET", "path": "/repos/octocat/hello-world", "operation_id": null },
      "allowed": false
    },
    {
      "name": "prefix rule with {placeholder} matches deeper concrete path",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/{owner}/{repo}",
          "match_mode": "prefix"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/repos/octocat/hello-world/commits",
        "operation_id": null
      },
      "allowed": true
    },
    {
      "name": "prefix rule with {placeholder} rejects wrong fixed segment",
      "rules": [
        {
          "effect": "allow",
          "methods": ["GET"],
          "path": "/repos/{owner}/{repo}",
          "match_mode": "prefix"
        }
      ],
      "request": { "method": "GET", "path": "/users/octocat", "operation_id": null },
      "allowed": false
    }
  ]
}
